{
	"name": "pronamic/wp-orbis-projects",
	"description": "The Orbis Projects plugin extends your Orbis environment with the option to manage projects.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"orbis",
		"projects",
		"wordpress",
		"plugin",
		"bootstrap"
	],
	"homepage": "https://www.pronamic.eu/orbis/",
	"authors": [
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl",
			"role": "Developer"
		},
		{
			"name": "Karel-Jan Tolsma",
			"email": "info@kareljantolsma.nl",
			"homepage": "http://www.kareljantolsma.nl",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@pronamic.nl",
		"issues": "https://github.com/pronamic/wp-orbis/issues",
		"source": "https://github.com/pronamic/wp-orbis"
	},
	"type": "wordpress-plugin",
	"autoload": {
		"files": [
			"includes/functions.php"
		],
		"psr-4": {
			"Pronamic\\Orbis\\Projects\\": "classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"wp-slug": "orbis-projects"
	},
	"require": {
		"php": ">=8.2",
		"automattic/jetpack-autoloader": "^3.0",
		"pronamic/wp-money": "^2.4",
		"sabre/vobject": "^4.1",
		"sabre/uri": "^1",
		"sabre/xml": "^1",
		"woocommerce/action-scheduler": "^3.9"
	},
	"require-dev": {
		"pronamic/wp-coding-standards": "^2.1",
		"rector/rector": "^2.6",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"deployer/deployer": "^7.5",
		"roots/wordpress-no-content": "^7.1"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rm -rf ./build/orbis-projects",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis-projects/",
			"vendor/bin/wp i18n make-pot ./build/orbis-projects/ --slug=orbis-projects",
			"vendor/bin/wp i18n make-mo ./build/orbis-projects/languages/",
			"vendor/bin/wp dist-archive ./build/orbis-projects/ --plugin-dirname=orbis-projects --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis-projects",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis-projects/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis-projects.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"rector": "vendor/bin/rector",
		"qa": [
			"@phpcs"
		]
	}
}
